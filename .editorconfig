# Formatação comum a qualquer editor (VS Code, JetBrains, Vim…). Ajuste ao padrão da sua stack.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{json,yml,yaml,js,jsx,ts,tsx,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
